# Backend env — copy to backend/.env and fill in.
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# REQUIRED — the backend refuses to start without it (no fallback exists).
JWT_SECRET=

# Optional overrides
# DATABASE_URL=postgresql+psycopg://qkd:qkd@localhost:5432/qkd
# DEBUG=true

# CORS: comma-separated browser origins allowed to call the API.
# Unset -> localhost:5173/4173 defaults.
# ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com

# Session cookie SameSite policy. "lax" (default) is correct when the
# frontend and API share a site. Set to "none" for split deploys
# (frontend on vercel.app, API on render.com): browsers never attach Lax
# cookies to cross-site fetch/WebSocket handshakes, so auth would fail.
# "none" requires the cookie to be Secure — run uvicorn with
# --proxy-headers behind your TLS proxy (the Dockerfile already does).
# SESSION_COOKIE_SAMESITE=none

# AI run summaries (optional). Any OpenAI-compatible chat API works:
# set OPENAI_API_KEY; OPENAI_BASE_URL/OPENAI_MODEL to switch provider.
# Without a key the API serves deterministic fallback summaries.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
